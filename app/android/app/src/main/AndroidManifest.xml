<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:backupAgent=".FastBackupAgent"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- The status notification's next change and the regular exports (FastExport),
             and the reboots, updates and clock changes that drop or shift their alarms. -->
        <receiver android:name=".FastStatusReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.nouritsu.fasttrack.REFRESH_STATUS" />
                <action android:name="com.nouritsu.fasttrack.RUN_EXPORT" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <!-- navigator.vibrate, for haptics -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Export writes Documents/FastTrack/: Android 10 and older ask for this, 10 with
         requestLegacyExternalStorage too; 11 and newer need neither.
         https://capacitorjs.com/docs/apis/filesystem#android -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Stage alerts and the status notification (FastStatus) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16's Live Update for the status notification (FastStatus): a chip in the
         status bar. Granted at install; the user can switch it off for the app.
         https://developer.android.com/develop/ui/views/notifications/live-update -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Alarms on time for the status notification and regular exports (FastStatus,
         FastExport), where the user allows it -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Weights from openScale (OpenScalePlugin): its own permission, which the user
         grants once, and visibility of its provider on Android 11 and newer. -->
    <uses-permission android:name="com.health.openscale.READ_WRITE_DATA" />
    <queries>
        <package android:name="com.health.openscale" />
        <provider android:authorities="com.health.openscale.provider" />
    </queries>
    <!-- The status notification rebuilds itself after a reboot (FastStatusReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
